@echo off
echo Автоматическая отправка без конфликтов...

REM Синхронизация с удалённым репозиторием (игнорируя локальные изменения)
git fetch origin

REM Принудительно обновить до последней версии с удаленного
echo Принудительная синхронизация с GitHub...
git reset --hard origin/main

REM Добавить все локальные изменения
echo Добавление всех изменений...
git add .

REM Создать коммит
echo Создание коммита...
git commit -m "Автоматическое обновление: %date% %time%"

REM Отправить без конфликтов
echo Отправка на GitHub...
git push origin main

echo ✅ Готово! Все изменения отправлены успешно!
pause